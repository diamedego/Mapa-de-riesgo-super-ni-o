# Entorno
.venv/
__pycache__/
.DS_Store

# Datos pesados: se regeneran con los scripts de ingesta
data/raw/**
!data/raw/.gitkeep
data/silver/**
!data/silver/.gitkeep
# data/gold se versiona (tablas finales livianas)

# Credenciales
.env
*.key.json

# Capa bronze exportada (se regenera con sql/exportar_bronze.py)
data/bronze/
data/*.duckdb

# Consumo de IA: metadatos locales de sesiones (se regenera)
data/consumo_ia/

# Mapa base propio para la versión en claude.ai (se regenera con web/preparar_mapa_base.py; 64 MB)
web/datos/base/

# Notas de reels (transcripciones de contenido ajeno: no van al repo público)
REELS/

# Lluvia de los Niños en grilla, día por día (se regenera con earth_engine/lluvia_ninos.py; ~800 MB)
data/procesado/
# Caché de la validación de la lluvia (se regenera con earth_engine/validar_lluvia.py)
data/validacion/lluvia_fuentes_estaciones.json
data/validacion/lluvia_horaria/
